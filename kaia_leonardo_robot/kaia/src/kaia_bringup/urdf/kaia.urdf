<?xml version="1.0"?>
<robot name="kaia">
  <!-- Khung copy từ Leonardo unicycle.urdf, thay số đo THẬT Kaia:
       wheel radius 0.0325 (d=0.065), separation 0.2385 (đo thước) -->
  <link name="base_footprint"/>
  <link name="base_link">
    <visual>
      <geometry><box size="0.32 0.28 0.10"/></geometry>
    </visual>
  </link>
  <link name="laser_frame"/>
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/><child link="base_link"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
  </joint>
  <joint name="laser_joint" type="fixed">
    <parent link="base_footprint"/><child link="laser_frame"/>
    <origin xyz="0 0 0.10" rpy="0 0 0"/>
  </joint>
</robot>
